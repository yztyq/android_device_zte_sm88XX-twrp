on init
    # nf2: disabled. This is the SPU/strongbox flavour; on this device it aborts
    # with "Check failed: status == STATUS_OK" and crash-loops forever because
    # IKeyMintDevice/strongbox is not declared in the recovery VINTF manifest.
    # The TEE instance (vendor.keymint, onekeymint) is the one keystore2 uses.
    #start vendor.keymint-qti

service vendor.keymint-qti /vendor/bin/hw/android.hardware.security.keymint-service-spu-qti
    class early_hal
    user root
    group root drmrpc
    seclabel u:r:recovery:s0

on property:vendor.car.hiber=hiberExit
    stop vendor.keymint-qti
    start vendor.keymint-qti
    stop keystore2
    start keystore2
